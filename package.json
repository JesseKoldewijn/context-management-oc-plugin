{
  "name": "context-management-oc-plugin",
  "version": "0.1.0",
  "description": "OpenCode TUI sidebar plugin that shows a configured context threshold and notifies when it is reached",
  "keywords": [
    "context",
    "opencode",
    "opencode-plugin",
    "sidebar",
    "tokens"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.tsx"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.10",
    "@opencode-ai/sdk": "1.18.10",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "solid-js": "1.9.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.3",
    "@opentui/core": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": "1.9.12"
  },
  "engines": {
    "node": ">=20",
    "opencode": ">=1.4.3"
  }
}
